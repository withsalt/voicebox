<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.31.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\VoiceBox.Core\VoiceBox.Core.csproj" />
	</ItemGroup>

  <ItemGroup>
    <None Remove="runtimes\models\vad\fireredvad\*.ark" />
    <None Remove="runtimes\models\vad\fireredvad\*.onnx" />
    <None Include="runtimes\models\vad\fireredvad\*.ark" Pack="true" PackagePath="runtimes\models\vad\fireredvad\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="runtimes\models\vad\fireredvad\*.onnx" Pack="true" PackagePath="runtimes\models\vad\fireredvad\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\VoiceBox.VAD.FireRed.targets" Pack="true" PackagePath="build\VoiceBox.VAD.FireRed.targets" />
    <None Include="build\VoiceBox.VAD.FireRed.targets" Pack="true" PackagePath="buildTransitive\VoiceBox.VAD.FireRed.targets" />
  </ItemGroup>

</Project>
