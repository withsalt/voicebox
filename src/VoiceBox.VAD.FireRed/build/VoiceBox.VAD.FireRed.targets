<Project>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\models\vad\fireredvad\*.ark">
      <Link>runtimes\models\vad\fireredvad\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\models\vad\fireredvad\*.onnx">
      <Link>runtimes\models\vad\fireredvad\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
