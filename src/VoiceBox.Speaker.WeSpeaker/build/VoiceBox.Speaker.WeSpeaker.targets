<Project>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\models\speaker\wespeaker\**\*.onnx">
      <Link>runtimes\models\speaker\wespeaker\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\models\speaker\wespeaker\**\*.ini">
      <Link>runtimes\models\speaker\wespeaker\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\models\speaker\wespeaker\**\*.md">
      <Link>runtimes\models\speaker\wespeaker\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\models\speaker\wespeaker\**\*.txt">
      <Link>runtimes\models\speaker\wespeaker\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
