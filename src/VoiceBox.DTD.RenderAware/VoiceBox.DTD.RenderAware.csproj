<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceBox.Core\VoiceBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="runtimes\models\dtd\render-aware\*.*" />
    <None Include="runtimes\models\dtd\render-aware\*.*" Pack="true" PackagePath="runtimes\models\dtd\render-aware\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="build\VoiceBox.DTD.RenderAware.targets" Pack="true" PackagePath="build\VoiceBox.DTD.RenderAware.targets" />
    <None Include="build\VoiceBox.DTD.RenderAware.targets" Pack="true" PackagePath="buildTransitive\VoiceBox.DTD.RenderAware.targets" />
  </ItemGroup>

</Project>
