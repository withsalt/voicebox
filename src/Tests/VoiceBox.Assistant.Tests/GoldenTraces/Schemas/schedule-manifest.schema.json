{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voicebox.assistant/schedule-manifest/v1",
  "type": "object",
  "required": ["schema", "catalogVersion", "scenarioId", "oracleKind", "variants"],
  "properties": {
    "schema": { "const": "voicebox.assistant/schedule-manifest/v1" },
    "catalogVersion": { "type": "string" },
    "scenarioId": { "type": "string" },
    "oracleKind": { "enum": ["ExactTrace", "AllowedTraceSet"] },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scheduleId", "traceFile", "happensBefore", "status", "sha256"],
        "properties": {
          "scheduleId": { "type": "string" },
          "traceFile": { "type": "string" },
          "happensBefore": { "type": "string" },
          "status": { "enum": ["frozen"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  }
}
