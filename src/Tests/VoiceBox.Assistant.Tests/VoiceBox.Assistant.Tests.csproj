<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VoiceBox.Assistant\VoiceBox.Assistant.csproj" />
    <ProjectReference Include="..\..\VoiceBox.Assistant.Conversation\VoiceBox.Assistant.Conversation.csproj" />
    <ProjectReference Include="..\..\VoiceBox.LLM.OpenAI\VoiceBox.LLM.OpenAI.csproj" />
    <ProjectReference Include="..\..\VoiceBox.LLM.LLamaSharp\VoiceBox.LLM.LLamaSharp.csproj" />
    <ProjectReference Include="..\..\VoiceBox.ASR.Qwen3\VoiceBox.ASR.Qwen3.csproj" />
    <ProjectReference Include="..\..\VoiceBox.ASR.FireRedASR2\VoiceBox.ASR.FireRedASR2.csproj" />
    <ProjectReference Include="..\..\VoiceBox.ASR.Confucius4\VoiceBox.ASR.Confucius4.csproj" />
    <ProjectReference Include="..\..\VoiceBox.ASR.DoubaoOnline\VoiceBox.ASR.DoubaoOnline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GoldenTraces\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 验证实时播放缓冲区，无需加载原生音频设备。 -->
  <ItemGroup>
    <Compile Include="..\..\VoiceBox.Audio.MiniAudio\Backend\MiniAudioPlaybackQueue.cs" Link="Audio\MiniAudioPlaybackQueue.cs" />
    <Compile Include="..\..\VoiceBox.Audio.PortAudio\Backend\PortAudioPlaybackQueue.cs" Link="Audio\PortAudioPlaybackQueue.cs" />
    <Compile Include="..\..\VoiceBox.Audio.PortAudio\Models\QueueBuffer.cs" Link="Audio\PortAudioQueueBuffer.cs" />
  </ItemGroup>

  <!-- 验证 Demo 的模块源码，避免引用可执行项目并加载其 GPU/模型运行时依赖。 -->
  <ItemGroup>
    <Compile Include="..\..\Demos\VoiceAssistantDemo\ConsoleUI\*.cs" Link="Demo\ConsoleUI\%(Filename)%(Extension)" />
    <Compile Include="..\..\Demos\VoiceAssistantDemo\Logging\*.cs" Link="Demo\Logging\%(Filename)%(Extension)" />
    <Compile Include="..\..\Demos\VoiceAssistantDemo\Presentation\*.cs" Link="Demo\Presentation\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
