<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VoiceBox.DNR.Benchmark</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
    <!-- Gpu 变体让 ONNX 后端(DeepFilterNet/DPDFNet/Hush)可选 CUDA/DirectML; CPU 亦可跑。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VoiceBox.Core\VoiceBox.Core.csproj" />
    <!-- 被评测的 DNR 后端。各库自带的 ONNX/native 模型 (runtimes\...) 经其
         CopyToOutputDirectory 流入本项目输出 (与 VoiceBox.ASR.Qwen3.Benchmark 同理)。 -->
    <ProjectReference Include="..\..\VoiceBox.DNR.DeepFilterNet\VoiceBox.DNR.DeepFilterNet.csproj" />
    <ProjectReference Include="..\..\VoiceBox.DNR.DPDFNet\VoiceBox.DNR.DPDFNet.csproj" />
    <ProjectReference Include="..\..\VoiceBox.DNR.Hush\VoiceBox.DNR.Hush.csproj" />
    <ProjectReference Include="..\..\VoiceBox.DNR.RNNoise\VoiceBox.DNR.RNNoise.csproj" />
    <ProjectReference Include="..\..\VoiceBox.APM.WebRtc\VoiceBox.APM.WebRtc.csproj" />
  </ItemGroup>

</Project>
