         如需 GPU 改 Microsoft.ML.OnnxRuntime.DirectML 并设置 ExecutionProvider。 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\VoiceBox.Audio.PortAudio\VoiceBox.Audio.PortAudio.csproj" />
    <ProjectReference Include="..\..\VoiceBox.DNR.DeepFilterNet\VoiceBox.DNR.DeepFilterNet.csproj" />
  </ItemGroup>

</Project>
